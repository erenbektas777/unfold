# unfold - Ortam Değişkenleri (Sıfır Maliyetli Canlı Kurulum)
# Tüm harici servisler opsiyoneldir. Boş bırakıldığında unfold yerleşik SQLite,
# lokal moderasyon ve ekran içi anlık OTP doğrulaması ile %100 ücretsiz çalışır.

# 1. Güvenlik Anahtarları (Canlıya çıkarken rastgele güçlü metinlerle değiştirin)
SESSION_SECRET=unfold-change-this-to-a-long-random-secret-key-2026
MODERATION_SECRET=unfold-admin-2026

# 2. Yönetici E-postaları (Virgülle ayırarak kendi kayıtlı e-postanızı yazabilirsiniz)
ADMIN_EMAILS=

# 3. Opsiyonel Ücretsiz AI Moderasyon (Google AI Studio ücretsiz GEMINI_API_KEY)
GEMINI_API_KEY=

# 4. Opsiyonel E-posta Servisi (Resend ücretsiz plan - tanımlanmazsa anlık ekran kodu çalışır)
RESEND_API_KEY=
EMAIL_FROM=unfold <noreply@example.com>
